<instance format="XCSP3" type="COP">
  <variables>
    <array id="x" note="x[i] is the department at the ith position" size="[7]"> 0..6 </array>
    <array id="y" note="y[i] is the length of the department at the ith position" size="[7]"> 10 20 30 40 50 80 </array>
    <array id="d" note="d[i][j] is the end-to-start distance between the ith and the jth departments" size="[7][7]">
      <domain for="d[0][2] d[1][3] d[2][4] d[3][5] d[4][6]"> 10..80 </domain>
      <domain for="d[0][3] d[1][4] d[2][5] d[3][6]"> 30..130 </domain>
      <domain for="d[0][4] d[1][5] d[2][6]"> 60..180 </domain>
      <domain for="d[0][5] d[1][6]"> 100..220 </domain>
      <domain for="d[0][6]"> 150..250 </domain>
    </array>
    <array id="aux_gb" note="aux_gb[i] is the ith auxiliary variable having been automatically introduced" size="[15]"> 0..10 </array>
  </variables>
  <constraints>
    <allDifferent note="ensuring a linear ordering of the departments"> x[] </allDifferent>
    <group note="computing lengths">
      <extension>
        <list> %0 %1 </list>
        <supports> (0,40)(1,20)(2,50)(3,30)(4,10)(5,50)(6,80) </supports>
      </extension>
      <args> x[0] y[0] </args>
      <args> x[1] y[1] </args>
      <args> x[2] y[2] </args>
      <args> x[3] y[3] </args>
      <args> x[4] y[4] </args>
      <args> x[5] y[5] </args>
      <args> x[6] y[6] </args>
    </group>
    <block note="computing distances">
      <group>
        <intension> eq(%0,%1) </intension>
        <args> d[0][2] y[1] </args>
        <args> d[1][3] y[2] </args>
        <args> d[2][4] y[3] </args>
        <args> d[3][5] y[4] </args>
        <args> d[4][6] y[5] </args>
      </group>
      <group>
        <sum>
          <list> %... </list>
          <condition> (eq,%0) </condition>
        </sum>
        <args> d[0][3] y[1] y[2] </args>
        <args> d[0][4] y[1..3] </args>
        <args> d[0][5] y[1..4] </args>
        <args> d[0][6] y[1..5] </args>
        <args> d[1][4] y[2] y[3] </args>
        <args> d[1][5] y[2..4] </args>
        <args> d[1][6] y[2..5] </args>
        <args> d[2][5] y[3] y[4] </args>
        <args> d[2][6] y[3..5] </args>
        <args> d[3][6] y[4] y[5] </args>
      </group>
    </block>
    <group>
      <element>
        <matrix> (0,5,2,4,1,0,0)(5,0,3,0,2,2,2)(2,3,0,1,0,2,5)(4,0,1,0,5,2,2)(1,2,0,5,0,10,0)(0,2,2,2,10,0,5)(0,2,5,2,0,5,0) </matrix>
        <index> %0 %1 </index>
        <value> %2 </value>
      </element>
      <args> x[0] x[2] aux_gb[0] </args>
      <args> x[0] x[3] aux_gb[1] </args>
      <args> x[0] x[4] aux_gb[2] </args>
      <args> x[0] x[5] aux_gb[3] </args>
      <args> x[0] x[6] aux_gb[4] </args>
      <args> x[1] x[3] aux_gb[5] </args>
      <args> x[1] x[4] aux_gb[6] </args>
      <args> x[1] x[5] aux_gb[7] </args>
      <args> x[1] x[6] aux_gb[8] </args>
      <args> x[2] x[4] aux_gb[9] </args>
      <args> x[2] x[5] aux_gb[10] </args>
      <args> x[2] x[6] aux_gb[11] </args>
      <args> x[3] x[5] aux_gb[12] </args>
      <args> x[3] x[6] aux_gb[13] </args>
      <args> x[4] x[6] aux_gb[14] </args>
    </group>
  </constraints>
  <objectives>
    <minimize note="minimizing weighted end-to-start distances" type="sum"> mul(d[0][2],aux_gb[0]) mul(d[0][3],aux_gb[1]) mul(d[0][4],aux_gb[2]) mul(d[0][5],aux_gb[3]) mul(d[0][6],aux_gb[4]) mul(d[1][3],aux_gb[5]) mul(d[1][4],aux_gb[6]) mul(d[1][5],aux_gb[7]) mul(d[1][6],aux_gb[8]) mul(d[2][4],aux_gb[9]) mul(d[2][5],aux_gb[10]) mul(d[2][6],aux_gb[11]) mul(d[3][5],aux_gb[12]) mul(d[3][6],aux_gb[13]) mul(d[4][6],aux_gb[14]) </minimize>
  </objectives>
</instance>
